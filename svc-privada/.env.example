# svc-privada — Variables de entorno para desarrollo local
# Copiar como .env y completar los valores

DATABASE_URL=postgresql+asyncpg://user_privada:devpassword@localhost:5433/db_privada
GCP_PROJECT_ID=gestorcooperativo
SERVICE_NAME=svc-privada
ENVIRONMENT=development
GOOGLE_JWKS_URI=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
GOOGLE_ISSUER=https://securetoken.google.com/gestorcooperativo

# Auth: svc-privada lee portal_usuarios llamando a un endpoint interno IAM-only de svc-vivienda
# (ADR-015). Vacío en dev -> el lookup degrada a rol "invitado".
# En Cloud Run: URL del Cloud Run de svc-vivienda (sin /api/v1), la SA de svc-privada
# necesita roles/run.invoker sobre svc-vivienda.
SVC_VIVIENDA_INTERNAL_URL=
